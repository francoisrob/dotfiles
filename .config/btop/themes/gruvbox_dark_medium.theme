# Gruvbox Dark, medium contrast (bg0 = #282828)
# Palette: https://github.com/morhetz/gruvbox
#
# Derived from btop's upstream gruvbox_dark.theme (by BachoSeven), which is
# hard contrast (bg0_h = #1d2021). Changes made here, all deliberate:
#   main_bg      #1d2021 -> #282828   medium contrast
#   selected_bg  #282828 -> #3c3836   stay one step above the background
#   inactive_fg  #282828 -> #665c54   upstream's value equals the medium
#                                     background, so it would be invisible
#   graph_text   #585858 -> #928374   #585858 is not a gruvbox color
#   temp_end     #fb4394 -> #fb4934   upstream typo, bright_red is #fb4934
#   free_start   #4e5900 -> #79740e   use gruvbox faded_green
#   download_*   solarized violets -> gruvbox faded/neutral/bright blue
#   upload_start #701c45 -> #8f3f71   use gruvbox faded_purple

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#282828"

# Main text color
theme[main_fg]="#a89984"

# Title color for boxes
theme[title]="#ebdbb2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d79921"

# Background color of selected items
theme[selected_bg]="#3c3836"

# Foreground color of selected items
theme[selected_fg]="#fabd2f"

# Color of inactive/disabled text
theme[inactive_fg]="#665c54"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#928374"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#98971a"

# Cpu box outline color
theme[cpu_box]="#a89984"

# Memory/disks box outline color
theme[mem_box]="#a89984"

# Net up/down box outline color
theme[net_box]="#a89984"

# Processes box outline color
theme[proc_box]="#a89984"

# Box divider line and small boxes line color
theme[div_line]="#a89984"

# Temperature graph colors
theme[temp_start]="#458588"
theme[temp_mid]="#d3869b"
theme[temp_end]="#fb4934"

# CPU graph colors
theme[cpu_start]="#b8bb26"
theme[cpu_mid]="#d79921"
theme[cpu_end]="#fb4934"

# Mem/Disk free meter
theme[free_start]="#79740e"
theme[free_mid]=""
theme[free_end]="#98971a"

# Mem/Disk cached meter
theme[cached_start]="#458588"
theme[cached_mid]=""
theme[cached_end]="#83a598"

# Mem/Disk available meter
theme[available_start]="#d79921"
theme[available_mid]=""
theme[available_end]="#fabd2f"

# Mem/Disk used meter
theme[used_start]="#cc241d"
theme[used_mid]=""
theme[used_end]="#fb4934"

# Download graph colors
theme[download_start]="#076678"
theme[download_mid]="#458588"
theme[download_end]="#83a598"

# Upload graph colors
theme[upload_start]="#8f3f71"
theme[upload_mid]="#b16286"
theme[upload_end]="#d3869b"
